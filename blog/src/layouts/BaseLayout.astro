---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { defaultDescription, getAppUrl, siteName } from '../data/site.js'
import '../styles/global.css'

const {
  title = siteName,
  description = defaultDescription,
  ogImage = '/og/mockup-studio-og.svg',
  structuredData = null,
  canonical: canonicalOverride = null,
  keywords = null,
} = Astro.props

const appUrl = getAppUrl()
const site = Astro.site ?? new URL('https://www.mockupeditor.site')
const canonical =
  canonicalOverride && String(canonicalOverride).trim()
    ? String(canonicalOverride).trim()
    : new URL(Astro.url.pathname + Astro.url.search, site).toString()
const keywordsContent = Array.isArray(keywords) && keywords.length ? keywords.join(', ') : null
const pageTitle = title === siteName ? title : `${title} | ${siteName}`
const ogImageUrl = new URL(ogImage, site).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywordsContent ? <meta name="keywords" content={keywordsContent} /> : null}
    <meta name="theme-color" content="#0f1117" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {structuredData ? (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    ) : null}
  </head>
  <body>
    <Header appUrl={appUrl} />
    <main>
      <slot />
    </main>
    <Footer appUrl={appUrl} />
  </body>
</html>

        <a href="/mobile-app-mockup-editor/">Mobile app mockup editor</a>
        <a href="/app-screenshot-mockup-editor/">App screenshot mockup editor</a>
        <a href={appUrl}>Open Mockup Studio</a>
      </div>

      <div>
        <p class="footer-title">Resources</p>
        <a href="/blog/">Blog</a>
        <a href="/blog/how-to-create-play-store-screenshots/">Create Play screenshots</a>
        <a href="/blog/play-store-screenshot-size-guide/">Screenshot size guide</a>

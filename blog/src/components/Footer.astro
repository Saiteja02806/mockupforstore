          <a href="/#footer" aria-label="Instagram">ig</a>
          <a href="/#footer" aria-label="YouTube">yt</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>Powered by Mockup Studio</span>
      <span>Real device mockups for faster store launches.</span>
    </div>
  </div>
</footer>

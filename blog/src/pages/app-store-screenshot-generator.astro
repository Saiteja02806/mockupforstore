---
import PillarPage from '../components/PillarPage.astro'

const title = 'App Store Screenshot Generator'
const description =
  'Generate store-ready App Store listing images from your raw captures: frames, backgrounds, text, and editing controls in Mockup Studio.'
const h1 = 'App Store screenshot generator'
const introParagraphs = [
  'A “generator” mindset is about speed: go from screenshots on disk to a cohesive set of listing images without redrawing device bezels for every slide.',
  'Mockup Studio combines frame presets with editing controls so you are not locked into one rigid template—you can still tune layout, copy, and background per shot.',
]

const features = [
  {
    title: 'Fast first version',
    body: 'Pick a frame, drop in your UI, add a headline, and export—ideal when you are validating positioning before polish.',
  },
  {
    title: 'Consistent series',
    body: 'Reuse background and type styles across the gallery so the listing feels like one product story.',
  },
  {
    title: 'Editor-grade control',
    body: 'When you need pixel tweaks, the same canvas behaves as an editor—not a one-off PNG from a rigid template.',
  },
]

const faqs = [
  {
    q: 'Generator vs editor—what is the difference?',
    a: 'Generators emphasize speed from a template; editors emphasize control. Mockup Studio blends both: quick presets with full mockup editing.',
  },
  {
    q: 'Can I match App Store Connect dimensions?',
    a: 'Yes—use our App Store requirements guide for phone and tablet ranges, then export from the studio when the layout reads at thumbnail scale.',
  },
]

const relatedLinks = [
  { href: '/app-store-screenshot-editor/', label: 'App Store screenshot editor' },
  { href: '/play-store-screenshot-generator/', label: 'Play Store screenshot generator' },
  { href: '/blog/app-store-screenshot-requirements-complete-guide/', label: 'App Store screenshot requirements' },
  { href: '/blog/how-to-add-text-to-app-screenshots/', label: 'How to add text to app screenshots' },
  { href: '/blog/play-store-vs-app-store-screenshots/', label: 'Play Store vs App Store screenshots' },
  { href: '/frames/', label: 'Device frames' },
]

const keywords = ['App Store screenshot generator', 'iOS mockup generator', 'iPhone listing screenshots']
---

<PillarPage
  title={title}
  description={description}
  h1={h1}
  eyebrow="App Store"
  introParagraphs={introParagraphs}
  features={features}
  faqs={faqs}
  relatedLinks={relatedLinks}
  primaryFrameId="borderless-phone-silver"
  keywords={keywords}
/>

{
  "name": "mockup-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-frames": "node scripts/sync-frames-to-public.mjs",
    "sync-blog": "node scripts/sync-blog-manifest.mjs",
    "strip-svg-filters": "node scripts/strip-frame-svg-filters.mjs",
    "test:store-editor": "node --test ./src/store-editor/storeEditorLayerCycle.test.mjs",
    "dev": "npm run sync-frames && npm run sync-blog && vite",
    "dev:vanilla": "npm run sync-frames && npm run sync-blog && vite --open /vanilla.html",
    "build": "npm run sync-frames && npm run sync-blog && node scripts/optimize-landing-carousel-webp.mjs && npm --prefix ./marketing-site run build && vite build && node scripts/merge-marketing-into-editor-dist.mjs && node scripts/verify-in-app-blog-dist.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "fabric": "^7.2.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.4"
  }
}

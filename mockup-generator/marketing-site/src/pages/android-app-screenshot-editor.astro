---
import PillarPage from '../components/PillarPage.astro'
import { getSiteUrl } from '../data/site.js'

const siteUrl = getSiteUrl().replace(/\/$/, '')
const canonical = `${siteUrl}/android-app-screenshot-editor/`

const title = 'Android App Screenshot Editor – Polish Frames, Text & Backgrounds for Play'
const description =
  'Edit Android app screenshots into professional Google Play mockups: real device frames, headline text, backgrounds, crop-friendly layouts, and export-ready sizes—built for manual polish, not bulk template dumps.'
const h1 = 'Android App Screenshot Editor'

const introParagraphs = [
  'Use this page when you need control: adjust the frame, rewrite the headline, tune the background, and finish corners and safe areas so each listing image reads clearly in tiny Play previews.',
  'If your goal is to blast through a six-slide set with matching layouts first, use our Android app screenshot generator workflow—then come back here for pixel-level finishing.',
]

const moatTitle = 'Editing, not just framing'
const moatBody =
  'Many tools stop at dropping a PNG into a bezel. Mockup Studio treats each slide like a designed asset: typography hierarchy, background separation from UI, and consistent margins so marketing and engineering screenshots stay aligned.'

const visualProof = {
  before: {
    src: '/assets/frames/google-pixel-7-obsidian-portrait.webp',
    alt: 'Android phone frame with UI placeholder for Google Play screenshot editing',
    caption: 'Frame + layout shell',
  },
  after: {
    src: '/assets/frames/samsung-galaxys21ultra-black-portrait.webp',
    alt: 'Alternate Android device frame for polished Play Store listing mockups',
    caption: 'Swap chassis to match your release',
  },
}

const bodySections = [
  {
    type: 'steps',
    title: 'Manual workflow from capture to Play-ready',
    items: [
      {
        title: 'Import your real UI',
        body: 'Bring emulator or device captures—PNG or JPEG—and pick an Android frame that matches how you ship (notch, punch hole, foldable).',
      },
      {
        title: 'Design the full slide',
        body: 'Set background treatment, headline and subcopy, spacing, and alignment so the story reads at thumbnail size.',
      },
      {
        title: 'Tune store specifics',
        body: 'Adjust corners, padding, and contrast so dense UI still separates from chrome when Google surfaces smaller previews.',
      },
      {
        title: 'Export at listing dimensions',
        body: 'Export consistent pixel dimensions across the set so Play Console uploads stay predictable release over release.',
      },
    ],
  },
  {
    type: 'bullets',
    title: 'What you control in the editor',
    items: [
      'Device frame + screen composition',
      'Headline and supporting text overlays',
      'Backgrounds and separation from UI',
      'Per-slide layout and spacing',
      'Fine adjustments before export',
    ],
  },
]

const features = [
  {
    title: 'Hardware diversity',
    body: 'Foldables, notched phones, and tablets—pick the chassis that matches release notes and screenshots users expect.',
  },
  {
    title: 'Readable in discovery surfaces',
    body: 'Design for legibility when Play shows tiny thumbnails beside your title and icon—not only full gallery width.',
  },
  {
    title: 'Editor-first positioning',
    body: 'Stay here for finishing work; pair with guides on capture hygiene and rejection pitfalls when you promote to production.',
  },
]

const faqs = [
  {
    q: 'Android app screenshot editor vs generator—which should I use?',
    a: 'Use this editor page when manual polish is the job: frames, text, backgrounds, and layout control. Use the Android app screenshot generator when you want to move faster through multi-slide sets with repeatable layouts.',
  },
  {
    q: 'Is this only for developers?',
    a: 'Marketers and solo founders use the same flow—anyone with captures who needs store-ready mockups without bouncing between Figma layers.',
  },
  {
    q: 'Do I need Android Studio integration?',
    a: 'Export images from the emulator or device, then compose in Mockup Studio in the browser—no IDE plugin required.',
  },
  {
    q: 'Can I match Google Play screenshot sizes?',
    a: 'Yes—start from our Play screenshot size guide, build your slides here, and export when the layout holds up at reduced scale.',
  },
]

const relatedLinks = [
  { href: '/android-app-screenshot-generator/', label: 'Android app screenshot generator (speed & sets)' },
  { href: '/play-store-screenshot-editor/', label: 'Play Store screenshot editor' },
  { href: '/app-screenshot-mockup-editor/', label: 'App screenshot mockup editor (cross-channel)' },
  { href: '/play-store-screenshot-generator/', label: 'Play Store screenshot generator' },
  { href: '/app-store-screenshot-generator/', label: 'App Store screenshot generator' },
  { href: '/blog/how-to-add-android-phone-frame-to-app-screenshot/', label: 'Add an Android phone frame' },
  { href: '/blog/best-device-frame-sizes-for-google-play-2025/', label: 'Device frame sizes for Google Play' },
  { href: '/blog/common-play-store-screenshot-mistakes/', label: 'Common Play Store screenshot mistakes' },
  { href: '/frames/', label: 'Browse Android-style frames' },
]

const keywords = [
  'Android app screenshot editor',
  'Edit Android app screenshots',
  'Google Play screenshot editor',
  'Android mockup editor',
]
---

<PillarPage
  title={title}
  description={description}
  h1={h1}
  eyebrow="Android"
  introParagraphs={introParagraphs}
  features={features}
  faqs={faqs}
  relatedLinks={relatedLinks}
  primaryFrameId="notch-phone"
  keywords={keywords}
  titleAsIs={true}
  moatTitle={moatTitle}
  moatBody={moatBody}
  visualProof={visualProof}
  canonical={canonical}
  bodySections={bodySections}
/>

---
import PillarPage from '../components/PillarPage.astro'
import { getSiteUrl } from '../data/site.js'

const siteUrl = getSiteUrl().replace(/\/$/, '')
const canonical = `${siteUrl}/play-store-screenshot-editor/`

const title = 'Play Store Screenshot Editor | Edit Android App Mockups Online'
const description =
  'Create and edit Play Store screenshots with Android frames, backgrounds, headline text, layouts, and export-ready mockups for your Google Play listing.'
const h1 = 'Play Store Screenshot Editor'

const introParagraphs = [
  'Mockup Editor is a Play Store screenshot editor that helps Android developers create complete Google Play mockups with phone frames, backgrounds, headline text, layouts, and export-ready sizes.',
  'Google Play can show your screenshots in search, collections, and your store listing—often smaller than full size. Listing art should read clearly as a complete mockup, not only as a raw UI capture.',
]

const moatTitle = 'Not just a phone frame generator'
const moatBody =
  'Most mockup tools help you place your app screenshot inside a device frame. Mockup Editor helps you design the full Play Store screenshot: Android frame, background, headline text, spacing, layout, and export-ready image.'

const visualProof = {
  before: {
    src: '/assets/frames/google-pixel-7-obsidian-portrait.webp',
    alt: 'Google Pixel–style Android frame for Play Store screenshot editing and composition',
    caption: 'Android frame + layout',
  },
  after: {
    src: '/assets/frames/samsung-galaxys21ultra-black-portrait.webp',
    alt: 'Samsung-style Android frame example for Google Play listing mockups',
    caption: 'Alternate Android frame',
  },
}

const features = [
  {
    title: 'Device frame + screen',
    body: 'Choose Android-friendly phone and tablet frames so your UI reads as a real product shot, not a floating rectangle.',
  },
  {
    title: 'Headline text and layout',
    body: 'Add short benefit-led headlines and keep them legible in thumbnail views—critical for Play discovery surfaces.',
  },
  {
    title: 'Background and export',
    body: 'Unify backgrounds across a screenshot set and export consistent dimensions for Play Console uploads.',
  },
]

const faqs = [
  {
    q: 'What is a Play Store screenshot editor?',
    a: 'A Play Store screenshot editor helps you design the full screenshot image for your Google Play listing, including Android frames, headline text, backgrounds, layout, and export size.',
  },
  {
    q: 'How is this different from a Play Store screenshot generator?',
    a: 'A generator usually creates screenshots from a template. An editor gives you more control over the frame, text, background, spacing, and final layout.',
  },
  {
    q: 'Can I add text to Play Store screenshots?',
    a: 'Yes. You can add headline text, subtitles, and feature callouts to your Play Store screenshots.',
  },
  {
    q: 'Can I create Play Store screenshots without Figma?',
    a: 'Yes. Mockup Editor lets you create store-ready Play Store mockups directly in the browser without using Figma or Photoshop.',
  },
  {
    q: 'Can I export screenshots for Google Play?',
    a: 'Yes. You can export edited screenshots for your Google Play listing.',
  },
]

const relatedLinks = [
  { href: '/play-store-screenshot-generator/', label: 'Play Store screenshot generator' },
  { href: '/play-store-mockup-editor/', label: 'Play Store mockup editor' },
  { href: '/app-store-screenshot-editor/', label: 'App Store screenshot editor' },
  { href: '/blog/how-to-create-play-store-screenshots/', label: 'How to create Play Store screenshots (workflow)' },
  { href: '/blog/play-store-screenshot-size-guide/', label: 'Play Store screenshot size guide' },
  { href: '/blog/how-to-add-text-to-app-screenshots/', label: 'How to add text to app screenshots' },
  { href: '/blog/how-to-make-play-store-screenshots-that-get-downloads/', label: 'Screenshots that support downloads' },
  { href: '/frames/', label: 'Browse device frames' },
]

const keywords = [
  'Play Store screenshot editor',
  'Play Store mockup editor',
  'Google Play screenshot editor',
  'Android app screenshot editor',
  'Edit Play Store screenshots',
  'Create Play Store mockups',
  'Play Store screenshot generator',
  'Google Play screenshot generator',
  'App screenshot mockup editor',
]
---

<PillarPage
  title={title}
  description={description}
  h1={h1}
  eyebrow="Google Play"
  introParagraphs={introParagraphs}
  features={features}
  faqs={faqs}
  relatedLinks={relatedLinks}
  primaryFrameId="punchhole-phone"
  keywords={keywords}
  titleAsIs={true}
  moatTitle={moatTitle}
  moatBody={moatBody}
  visualProof={visualProof}
  canonical={canonical}
/>
